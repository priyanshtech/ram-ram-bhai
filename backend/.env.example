# PostgreSQL Connection (Requires pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_support

# Redis Connection (For Background Jobs & Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your_super_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Model Settings
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
EMBEDDING_DIMENSIONS=2048

# OpenRouter (Leave empty to use Mock AI)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Security & Constraints
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=20

# Set to false in production!
DEVELOPMENT_MOCK_AI=true
  